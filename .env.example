# API en 3005; el frontend se sirve aparte (p. ej. npx serve frontend -l 4400)
# En Render, PORT lo asigna la plataforma.
PORT=3005

# Login (sin base de datos: credenciales en variables de entorno)
AUTH_USER=admin
AUTH_PASSWORD=cambia-esta-clave
JWT_SECRET=cambia-este-secreto-largo
JWT_EXPIRES_IN=12h

# Opcional: varios usuarios (JSON). Si lo usas, AUTH_USER/AUTH_PASSWORD también se aceptan.
# AUTH_USERS_JSON=[{"usuario":"admin","password":"clave1"},{"usuario":"almacen","password":"clave2"}]
